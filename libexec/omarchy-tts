#!/bin/bash

set -euo pipefail

export VK_DRIVER_FILES=${VK_DRIVER_FILES:-/usr/share/vulkan/icd.d/radeon_icd.json}
export GGML_VK_VISIBLE_DEVICES=${GGML_VK_VISIBLE_DEVICES:-0}

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-tts"
job_pid_file="$runtime_dir/job.pid"
pid_file="$runtime_dir/player.pid"
generation_log="$runtime_dir/generation.log"
queue_dir="$runtime_dir/queue"
tts_data_dir="${OMARCHY_T2_TTS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-t2/tts}"
synthesizer="${OMARCHY_T2_TTS_ENGINE:-/usr/lib/omarchy-t2/qwen-tts}"
queue_helper="${OMARCHY_T2_TTS_QUEUE_HELPER:-/usr/lib/omarchy-t2/tts-queue}"
model="$tts_data_dir/models/qwen-talker-1.7b-customvoice-Q4_K_M.gguf"
codec="$tts_data_dir/models/qwen-tokenizer-12hz-Q4_K_M.gguf"

mkdir -p "$runtime_dir"

player_pid() {
  [[ -f $pid_file ]] || return 1
  local pid player_executable
  read -r pid <"$pid_file"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -e /proc/$pid/exe ]] || return 1
  player_executable=$(readlink -f "$(command -v pw-play)")
  [[ $(readlink -f "/proc/$pid/exe") == "$player_executable" ]] || return 1
  printf '%s\n' "$pid"
}

job_pid() {
  [[ -f $job_pid_file ]] || return 1
  local pid
  local -a command_line

  read -r pid <"$job_pid_file"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -e /proc/$pid/exe ]] || return 1
  [[ $(readlink -f "/proc/$pid/exe") == "$(readlink -f "$(command -v bash)")" ]] || return 1
  mapfile -d '' -t command_line <"/proc/$pid/cmdline"
  [[ ${command_line[1]:-} == "$0" && ${command_line[2]:-} == read ]] || return 1
  printf '%s\n' "$pid"
}

collect_process_tree() {
  local root=$1 current
  local -a pending=("$root") children

  while ((${#pending[@]})); do
    current=${pending[0]}
    pending=("${pending[@]:1}")
    [[ -e /proc/$current/status ]] || continue
    children=()
    read -ra children <"/proc/$current/task/$current/children" || true
    pending+=("${children[@]}")
    printf '%s\n' "$current"
  done
}

terminate_process_tree() {
  local root=$1 pid attempt alive
  local -a job_pids

  mapfile -t job_pids < <(collect_process_tree "$root")
  ((${#job_pids[@]})) || return
  kill -TERM "${job_pids[@]}" 2>/dev/null || true
  kill -CONT "${job_pids[@]}" 2>/dev/null || true

  for attempt in {1..20}; do
    alive=0
    for pid in "${job_pids[@]}"; do
      kill -0 "$pid" 2>/dev/null && alive=1
    done
    ((alive == 0)) && break
    sleep 0.05
  done
  ((alive == 0)) || kill -KILL "${job_pids[@]}" 2>/dev/null || true
}

stop_job() {
  local pid job

  if job=$(job_pid); then
    : >"$job_pid_file"
    : >"$pid_file"
    terminate_process_tree "$job"
  elif pid=$(player_pid); then
    : >"$pid_file"
    terminate_process_tree "$pid"
  else
    : >"$job_pid_file"
    : >"$pid_file"
  fi

  rm -rf -- "$queue_dir"
  rm -f "$runtime_dir/source.wav" "$runtime_dir/speech.wav"
}

finish_job() {
  local job=$1 error=${2:-} current_job=""

  [[ -f $job_pid_file ]] && read -r current_job <"$job_pid_file"
  if [[ $current_job == "$job" ]]; then
    : >"$job_pid_file"
    : >"$pid_file"
    rm -rf -- "$queue_dir"
    [[ -z $error ]] || notify-send -u critical "Read selected text" "$error"
  fi
}

require_tts() {
  if [[ ! -x $synthesizer ]]; then
    notify-send -u critical "Read selected text" "Optional Qwen TTS engine is not installed; see omarchy-t2 documentation"
    exit 1
  fi
  if [[ ! -f $model || ! -f $codec ]]; then
    notify-send -u critical "Read selected text" "Run 'omarchy-t2 tts setup' first"
    exit 1
  fi
  if [[ ! -x $queue_helper ]]; then
    notify-send -u critical "Read selected text" "The TTS queue helper is not installed"
    exit 1
  fi
}

render_and_play() {
  local text=$1 job=$BASHPID producer player status index total
  local chunks_file complete_file failed_file source_audio playback_audio

  printf '%s\n' "$job" >"$job_pid_file"
  rm -rf -- "$queue_dir"
  mkdir -p "$queue_dir"
  chunks_file="$queue_dir/chunks.txt"
  complete_file="$queue_dir/complete"
  failed_file="$queue_dir/failed"

  if ! printf '%s' "$text" | "$queue_helper" split >"$chunks_file" 2>"$generation_log"; then
    finish_job "$job" "Text preparation failed"
    return
  fi
  total=$(wc -l <"$chunks_file")
  if ((total == 0)); then
    finish_job "$job" "No readable text remained after removing links and filenames"
    return
  fi

  notify-send -u low -t 2000 "Read selected text" "Preparing $total speech sections…"

  if "$synthesizer" \
      --model "$model" \
      --codec "$codec" \
      --speaker vivian \
      --lang English \
      --instruct "Speak as a friendly young adult woman with clear natural articulation, gentle positive energy, subtle expression, and an even conversational delivery. Sound engaged but calm, never overly enthusiastic." \
      --seed 42 \
      --stream-by-line \
      -o - <"$chunks_file" 2>>"$generation_log" 9>&- |
      "$queue_helper" unpack "$queue_dir" 2>>"$generation_log" 9>&-; then
    : >"$complete_file"
  else
    : >"$failed_file"
  fi &
  producer=$!

  for ((index = 1; index <= total; index++)); do
    printf -v source_audio '%s/%06d.wav' "$queue_dir" "$index"
    printf -v playback_audio '%s/%06d-play.wav' "$queue_dir" "$index"
    while [[ ! -f $source_audio ]]; do
      if [[ -f $failed_file ]]; then
        wait "$producer" || true
        finish_job "$job" "Speech generation failed at section $index of $total"
        return
      fi
      if ! kill -0 "$producer" 2>/dev/null; then
        if [[ -f $complete_file ]]; then
          finish_job "$job" "Speech generation ended before section $index of $total"
        else
          finish_job "$job" "Speech generation stopped at section $index of $total"
        fi
        return
      fi
      sleep 0.05
    done

    if ! ffmpeg -y -hide_banner -loglevel error -i "$source_audio" -filter:a atempo=1.25 \
      -c:a pcm_s16le -ar 24000 -ac 1 "$playback_audio" 2>>"$generation_log" 9>&-; then
      terminate_process_tree "$producer"
      finish_job "$job" "Speech processing failed at section $index of $total"
      return
    fi
    rm -f "$source_audio"

    if ((index == 1)); then
      notify-send -u low -t 2000 "Read selected text" "Playing $total speech sections"
    fi
    pw-play "$playback_audio" >/dev/null 2>&1 9>&- &
    player=$!
    printf '%s\n' "$player" >"$pid_file"
    if wait "$player"; then
      status=0
    else
      status=$?
    fi
    : >"$pid_file"
    rm -f "$playback_audio"

    if ((status != 0)); then
      terminate_process_tree "$producer"
      finish_job "$job" "Speech playback failed at section $index of $total"
      return
    fi
  done

  if ! wait "$producer" || [[ ! -f $complete_file ]]; then
    finish_job "$job" "Speech generation did not finish cleanly"
    return
  fi
  finish_job "$job"
}

read_selection() {
  local text
  require_tts
  text=$(wl-paste --primary --no-newline 2>/dev/null || true)
  if [[ -z ${text//[[:space:]]/} ]]; then
    notify-send -u low "Read selected text" "Select some text first"
    exit 1
  fi

  stop_job
  exec 9>"$runtime_dir/synthesis.lock"
  if ! flock -w 3 9; then
    notify-send -u low "Read selected text" "Previous speech is still stopping"
    exit 1
  fi

  notify-send -u low -t 2000 "Read selected text" "Preparing speech…"
  render_and_play "$text" &
  printf '%s\n' "$!" >"$job_pid_file"
}

toggle_pause() {
  local pid state
  if ! pid=$(player_pid); then
    if job_pid >/dev/null; then
      notify-send -u low "Read selected text" "Speech is still being generated"
    else
      notify-send -u low "Read selected text" "Nothing is currently being read"
    fi
    exit 1
  fi

  state=$(awk '{ print $3 }' "/proc/$pid/stat")
  if [[ $state == T ]]; then
    kill -CONT "$pid"
    notify-send -u low "Read selected text" "Resumed"
  else
    kill -STOP "$pid"
    notify-send -u low "Read selected text" "Paused"
  fi
}

case ${1:-} in
read) read_selection ;;
toggle-pause) toggle_pause ;;
stop) stop_job ;;
*) echo "usage: omarchy-tts {read|toggle-pause|stop}" >&2; exit 2 ;;
esac
