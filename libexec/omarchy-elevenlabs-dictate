#!/usr/bin/env bash
set -euo pipefail
unit=elevenlabs-dictate.service
exec 9>"${XDG_RUNTIME_DIR:?}/elevenlabs-dictate-control.lock"
flock 9
case "${1:-}" in
  start)
    if ! systemctl --user is-active --quiet "$unit"; then
      systemd-run --user --quiet --collect --unit="$unit" \
        --property=RuntimeDirectory=elevenlabs-dictate --property=RuntimeDirectoryMode=0700 \
        --property=UMask=0077 /usr/bin/python3 "${OMARCHY_T2_LIB_DIR:-/usr/lib/omarchy-t2}/elevenlabs-dictate.py"
    fi
    ;;
  stop)
    if systemctl --user is-active --quiet "$unit" && [[ -d "$XDG_RUNTIME_DIR/elevenlabs-dictate" ]]; then
      touch "$XDG_RUNTIME_DIR/elevenlabs-dictate/stop"
    fi
    ;;
  *) echo 'Usage: elevenlabs-dictate start|stop' >&2; exit 2 ;;
esac
