post_install() {
  echo
  echo "Run 'omarchy-t2 setup' as your normal Omarchy user to apply T2 defaults."
  echo "Preview first with 'omarchy-t2 setup --dry-run'."
  echo "Inspect or personalize power policy with 'omarchy-t2 power status'."
  echo "Optional: run 'omarchy-t2 touchbar setup' for the React DRM Touch Bar."
  echo "Optional: install a Qwen TTS engine, then run 'omarchy-t2 tts setup'."
  echo
}

post_upgrade() {
  echo
  echo "Run 'omarchy-t2 doctor' after upgrading to verify hardware support."
  echo "Inspect or personalize power policy with 'omarchy-t2 power status'."
  echo "Optional: run 'omarchy-t2 touchbar setup' for the React DRM Touch Bar."
  echo "Optional: install a Qwen TTS engine, then run 'omarchy-t2 tts setup'."
  echo
}
