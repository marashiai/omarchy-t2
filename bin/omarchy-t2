#!/bin/bash

set -euo pipefail

VERSION=0.4.0
SUPPORTED_MODEL=MacBookPro16,1

ROOT=${OMARCHY_T2_ROOT:-}
SHARE_DIR=${OMARCHY_T2_SHARE_DIR:-$ROOT/usr/share/omarchy-t2}
LIB_DIR=${OMARCHY_T2_LIB_DIR:-$ROOT/usr/lib/omarchy-t2}
SYSTEM_CONFIG="$ROOT/etc/omarchy-t2.conf"
SYSTEM_STATE="$ROOT/var/lib/omarchy-t2"
POWER_SERVICE_STATE="$SYSTEM_STATE/power-optimizer.service.state"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-t2"
USER_CONFIG="$USER_CONFIG_DIR/config"
USER_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-t2"
DMI_PATH=${OMARCHY_T2_DMI_PATH:-$ROOT/sys/devices/virtual/dmi/id/product_name}
SKIP_RUNTIME=${OMARCHY_T2_SKIP_RUNTIME:-false}
DRY_RUN=false
TTS_DATA_DIR=${OMARCHY_T2_TTS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-t2/tts}
TTS_MODEL_DIR="$TTS_DATA_DIR/models"
TTS_ENGINE=${OMARCHY_T2_TTS_ENGINE:-$LIB_DIR/qwen-tts}
TTS_TALKER=qwen-talker-1.7b-customvoice-Q4_K_M.gguf
TTS_CODEC=qwen-tokenizer-12hz-Q4_K_M.gguf
TTS_TALKER_URL=${OMARCHY_T2_TTS_TALKER_URL:-https://huggingface.co/Serveurperso/Qwen3-TTS-GGUF/resolve/main/$TTS_TALKER}
TTS_CODEC_URL=${OMARCHY_T2_TTS_CODEC_URL:-https://huggingface.co/Serveurperso/Qwen3-TTS-GGUF/resolve/main/$TTS_CODEC}
TTS_TALKER_SHA256=${OMARCHY_T2_TTS_TALKER_SHA256:-cc328834a631bc08bf9f43e62fa23f8a1383d9b429864ce6690cfb172077fc4a}
TTS_CODEC_SHA256=${OMARCHY_T2_TTS_CODEC_SHA256:-cf3788b4d50aaa665fb6e57c170396aae03a3555fea52d2b5d0cda902d658039}
TOUCHBAR_REPO_URL=https://github.com/aminmarashi/react-drm-for-touchbar.git
TOUCHBAR_DIR=${OMARCHY_T2_TOUCHBAR_DIR:-$HOME/react-drm}

usage() {
  cat <<'EOF'
Omarchy support and tuning for Intel T2 MacBook Pros.

Usage:
  omarchy-t2 setup [--defaults] [--bluetooth] [--yes] [--dry-run]
  omarchy-t2 status
  omarchy-t2 doctor
  omarchy-t2 battery [status | limit <50-100>]
  omarchy-t2 fan [status | profile <cool|balanced|quiet> | max | normal | toggle]
  omarchy-t2 power [status | enable | disable]
  omarchy-t2 power profiles <ac> <battery>
  omarchy-t2 power thermal off
  omarchy-t2 power thermal on <warm-c> <hot-c> <warm-idle> <hot-idle>
  omarchy-t2 power <profile-switching|gpu-saving|wifi-saving|usb-autosuspend> <on|off>
  omarchy-t2 input [status | keyboard <layout> [variant] | tap <on|off>]
  omarchy-t2 audio [status | enable | disable | speakers <on|off> | mic <on|off>]
  omarchy-t2 bluetooth [status | enable | disable]
  omarchy-t2 gpu [status | toggle | integrated | dedicated]
  omarchy-t2 touchbar [status | analyze | setup | update | enable | disable | uninstall]
  omarchy-t2 tts [status | setup [--yes] [--dry-run] | enable | disable | remove [--yes]]
  omarchy-t2 tts setup --provider <qwen|elevenlabs> [--yes] [--dry-run]
  omarchy-t2 tts auth
  omarchy-t2 stt [status | setup [--yes] [--dry-run] | auth | enable | disable]
  omarchy-t2 restore [--yes]
  omarchy-t2 version

The initial release supports MacBookPro16,1 exactly. Hardware-changing commands
refuse to run on any other model.
EOF
}

die() {
  echo "omarchy-t2: $*" >&2
  exit 1
}

note() {
  echo "==> $*"
}

run_root() {
  if [[ $DRY_RUN == true ]]; then
    printf '    +'
    printf ' %q' "$@"
    printf '\n'
  elif [[ -n $ROOT || $EUID == 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

runtime() {
  [[ -z $ROOT && $SKIP_RUNTIME != true && $DRY_RUN != true ]]
}

user_systemctl() {
  runtime || return 0
  systemctl --user "$@"
}

model_name() {
  if [[ -r $DMI_PATH ]]; then
    tr -d '\n' <"$DMI_PATH"
  else
    echo unknown
  fi
}

require_supported_model() {
  local model
  model=$(model_name)
  [[ $model == "$SUPPORTED_MODEL" ]] || die "unsupported model '$model' (expected $SUPPORTED_MODEL)"
}

confirm() {
  local prompt=$1
  local assume_yes=${2:-false}

  [[ $assume_yes == true || $DRY_RUN == true ]] && return 0
  if command -v gum >/dev/null 2>&1; then
    gum confirm "$prompt"
  else
    read -r -p "$prompt [y/N] " answer
    [[ ${answer,,} == y || ${answer,,} == yes ]]
  fi
}

system_backup_path() {
  local target=$1
  local relative=$target
  [[ -n $ROOT ]] && relative=${target#"$ROOT"}
  printf '%s/backups%s' "$SYSTEM_STATE" "$relative"
}

user_backup_path() {
  local target=$1
  local relative=${target#"$HOME"}
  printf '%s/backups/home%s' "$USER_STATE" "$relative"
}

backup_system_file() {
  local target=$1
  local backup
  backup=$(system_backup_path "$target")

  if [[ -e $target || -L $target ]] && [[ ! -e $backup && ! -L $backup ]]; then
    run_root install -d -m 0755 "$(dirname "$backup")"
    run_root cp -a "$target" "$backup"
  fi
}

backup_user_file() {
  local target=$1
  local backup
  backup=$(user_backup_path "$target")

  if [[ -e $target || -L $target ]] && [[ ! -e $backup && ! -L $backup ]]; then
    install -d -m 0755 "$(dirname "$backup")"
    cp -a "$target" "$backup"
  fi
}

replace_system_link() {
  local source=$1
  local target=$2

  [[ -e $source ]] || die "package asset is missing: $source"
  if [[ -L $target && $(readlink "$target") == "$source" ]]; then
    return 0
  fi
  backup_system_file "$target"
  run_root install -d -m 0755 "$(dirname "$target")"
  run_root rm -f "$target"
  run_root ln -s "$source" "$target"
}

replace_user_link() {
  local source=$1
  local target=$2

  [[ -e $source ]] || die "package asset is missing: $source"
  if [[ -L $target && $(readlink "$target") == "$source" ]]; then
    return 0
  fi
  backup_user_file "$target"
  install -d -m 0755 "$(dirname "$target")"
  rm -f "$target"
  ln -s "$source" "$target"
}

restore_system_file() {
  local target=$1
  local backup
  backup=$(system_backup_path "$target")

  run_root rm -f "$target"
  if [[ -e $backup || -L $backup ]]; then
    run_root install -d -m 0755 "$(dirname "$target")"
    run_root cp -a "$backup" "$target"
  fi
}

restore_user_file() {
  local target=$1
  local backup
  backup=$(user_backup_path "$target")

  rm -f "$target"
  if [[ -e $backup || -L $backup ]]; then
    install -d -m 0755 "$(dirname "$target")"
    cp -a "$backup" "$target"
  fi
}

install_root_text() {
  local target=$1
  local mode=$2
  local temporary
  temporary=$(mktemp)
  cat >"$temporary"
  backup_system_file "$target"
  run_root install -Dm"$mode" "$temporary" "$target"
  rm -f "$temporary"
}

write_setting() {
  local file=$1
  local key=$2
  local value=$3
  local scope=$4
  local temporary
  temporary=$(mktemp)

  if [[ -r $file ]]; then
    awk -v key="$key" -v value="$value" '
      BEGIN { found = 0 }
      $0 ~ "^" key "=" { print key "=" value; found = 1; next }
      { print }
      END { if (!found) print key "=" value }
    ' "$file" >"$temporary"
  else
    printf '%s=%s\n' "$key" "$value" >"$temporary"
  fi

  if [[ $scope == root ]]; then
    run_root install -Dm0644 "$temporary" "$file"
  else
    install -Dm0644 "$temporary" "$file"
  fi
  rm -f "$temporary"
}

load_system_config() {
  BATTERY_LIMIT=95
  FAN_PROFILE=cool
  POWER_ENABLED=true
  POWER_PROFILE_SWITCHING=true
  POWER_AC_PROFILE=performance
  POWER_BATTERY_PROFILE=power-saver
  POWER_GPU_SAVING=true
  POWER_GPU_PROFILE=2
  POWER_WIFI_SAVING=true
  POWER_USB_AUTOSUSPEND=true
  POWER_THERMAL_IDLE=true
  POWER_WARM_C=45
  POWER_HOT_C=65
  POWER_WARM_RECOVERY_C=40
  POWER_HOT_RECOVERY_C=60
  POWER_WARM_IDLE_PERCENT=15
  POWER_HOT_IDLE_PERCENT=50
  if [[ -r $SYSTEM_CONFIG ]]; then
    # shellcheck source=/dev/null
    source "$SYSTEM_CONFIG"
  fi
}

load_input_config() {
  KEYBOARD_LAYOUT=us
  KEYBOARD_VARIANT=mac-iso
  TAP_TO_CLICK=false
  TTS_ENABLED=false
  TTS_PROVIDER=qwen
  STT_ENABLED=false
  if [[ -r $USER_CONFIG ]]; then
    # shellcheck source=/dev/null
    source "$USER_CONFIG"
  fi
}

setup_touchpad() {
  local legacy="$ROOT/etc/udev/rules.d/99-omarchy-apple-t2-touchpad.rules"
  local target="$ROOT/etc/udev/rules.d/99-omarchy-t2-touchpad.rules"

  if [[ -e $legacy || -L $legacy ]]; then
    backup_system_file "$legacy"
    run_root rm -f "$legacy"
  fi
  replace_system_link "$SHARE_DIR/rules/99-omarchy-apple-t2-touchpad.rules" "$target"

  if runtime; then
    sudo udevadm control --reload
    sudo udevadm trigger --subsystem-match=input --action=change
  fi
}

battery_limit() {
  local limit=$1
  if [[ ! $limit =~ ^[0-9]+$ ]] || ((limit < 50 || limit > 100)); then
    die "battery limit must be between 50 and 100"
  fi

  write_setting "$SYSTEM_CONFIG" BATTERY_LIMIT "$limit" root
  replace_system_link "$SHARE_DIR/rules/90-omarchy-t2-battery.rules" "$ROOT/etc/udev/rules.d/90-omarchy-t2-battery.rules"
  if runtime; then
    sudo systemctl daemon-reload
    sudo systemctl enable --now omarchy-t2-battery-limit.service
  fi
  note "Battery charge limit: $limit%"
}

fan_profile() {
  local profile=$1
  local source="$SHARE_DIR/fan/t2fand-$profile.conf"
  [[ -f $source ]] || die "fan profile must be cool, balanced, or quiet"

  backup_system_file "$ROOT/etc/t2fand.conf"
  run_root install -Dm0644 "$source" "$ROOT/etc/t2fand.conf"
  write_setting "$SYSTEM_CONFIG" FAN_PROFILE "$profile" root
  if runtime; then
    sudo systemctl enable --now t2fanrd.service
    sudo systemctl restart t2fanrd.service
  fi
  note "Fan profile: $profile"
}

power_restart() {
  if runtime; then
    sudo systemctl daemon-reload
    sudo systemctl try-restart power-optimizer.service
  fi
}

save_power_service_state() {
  local state=disabled temporary

  runtime || return 0
  [[ ! -r $POWER_SERVICE_STATE ]] || return 0
  systemctl is-enabled --quiet power-optimizer.service 2>/dev/null && state=enabled
  temporary=$(mktemp)
  printf '%s\n' "$state" >"$temporary"
  run_root install -Dm0644 "$temporary" "$POWER_SERVICE_STATE"
  rm -f "$temporary"
}

power_enable() {
  save_power_service_state
  replace_system_link \
    "$ROOT/usr/lib/systemd/system/power-optimizer.service" \
    "$ROOT/etc/systemd/system/power-optimizer.service"
  write_setting "$SYSTEM_CONFIG" POWER_ENABLED true root
  if runtime; then
    sudo systemctl daemon-reload
    sudo systemctl enable --now power-optimizer.service
  fi
  note "Adaptive power policy enabled."
}

power_disable() {
  write_setting "$SYSTEM_CONFIG" POWER_ENABLED false root
  if runtime; then
    sudo systemctl disable --now power-optimizer.service
  fi
  note "Adaptive power policy disabled."
}

power_boolean_value() {
  case $1 in
  on) echo true ;;
  off) echo false ;;
  *) die "value must be on or off" ;;
  esac
}

power_boolean_setting() {
  local key=$1 value
  value=$(power_boolean_value "$2")
  write_setting "$SYSTEM_CONFIG" "$key" "$value" root
  power_restart
}

power_profiles() {
  local profile
  for profile in "$1" "$2"; do
    case $profile in
    performance|balanced|power-saver) ;;
    *) die "power profiles must be performance, balanced, or power-saver" ;;
    esac
  done
  write_setting "$SYSTEM_CONFIG" POWER_AC_PROFILE "$1" root
  write_setting "$SYSTEM_CONFIG" POWER_BATTERY_PROFILE "$2" root
  write_setting "$SYSTEM_CONFIG" POWER_PROFILE_SWITCHING true root
  power_restart
}

power_thermal() {
  local warm hot warm_idle hot_idle

  case ${1:-} in
  off)
    [[ $# == 1 ]] || die "usage: omarchy-t2 power thermal off"
    write_setting "$SYSTEM_CONFIG" POWER_THERMAL_IDLE false root
    ;;
  on)
    [[ $# == 5 ]] || die "usage: omarchy-t2 power thermal on <warm-c> <hot-c> <warm-idle> <hot-idle>"
    warm=$2
    hot=$3
    warm_idle=$4
    hot_idle=$5
    [[ $warm =~ ^[0-9]+$ && $hot =~ ^[0-9]+$ ]] || die "thermal temperatures must be whole degrees Celsius"
    [[ $warm_idle =~ ^[0-9]+$ && $hot_idle =~ ^[0-9]+$ ]] || die "forced idle values must be percentages"
    ((warm >= 35 && hot <= 95 && hot - warm >= 5)) || die "thermal range must be 35-95°C with hot at least 5°C above warm"
    ((warm_idle <= hot_idle && hot_idle <= 50)) || die "forced idle must rise from warm to hot and cannot exceed 50%"
    write_setting "$SYSTEM_CONFIG" POWER_THERMAL_IDLE true root
    write_setting "$SYSTEM_CONFIG" POWER_WARM_C "$warm" root
    write_setting "$SYSTEM_CONFIG" POWER_HOT_C "$hot" root
    write_setting "$SYSTEM_CONFIG" POWER_WARM_RECOVERY_C "$((warm - 5))" root
    write_setting "$SYSTEM_CONFIG" POWER_HOT_RECOVERY_C "$((hot - 5))" root
    write_setting "$SYSTEM_CONFIG" POWER_WARM_IDLE_PERCENT "$warm_idle" root
    write_setting "$SYSTEM_CONFIG" POWER_HOT_IDLE_PERCENT "$hot_idle" root
    ;;
  *) die "usage: omarchy-t2 power thermal <off | on <warm-c> <hot-c> <warm-idle> <hot-idle>>" ;;
  esac
  power_restart
}

power_status() {
  local live_profile=unavailable live_source=unknown live_state=unknown service
  service=$(service_actual_state power-optimizer.service)
  load_system_config
  if runtime; then
    live_profile=$(powerprofilesctl get 2>/dev/null || echo unavailable)
    [[ -r /run/power-optimizer/power_source ]] && live_source=$(< /run/power-optimizer/power_source)
    [[ -r /run/power-optimizer/thermal_state ]] && live_state=$(< /run/power-optimizer/thermal_state)
  fi
  cat <<EOF
service=$service
configured.enabled=$POWER_ENABLED
configured.profiles=$POWER_AC_PROFILE/$POWER_BATTERY_PROFILE automatic=$POWER_PROFILE_SWITCHING
configured.gpu-saving=$POWER_GPU_SAVING profile=$POWER_GPU_PROFILE
configured.wifi-saving=$POWER_WIFI_SAVING
configured.usb-autosuspend=$POWER_USB_AUTOSUSPEND
configured.thermal-idle=$POWER_THERMAL_IDLE range=${POWER_WARM_C}-${POWER_HOT_C}C idle=${POWER_WARM_IDLE_PERCENT}-${POWER_HOT_IDLE_PERCENT}% recovery=${POWER_WARM_RECOVERY_C}/${POWER_HOT_RECOVERY_C}C
live=source:$live_source profile:$live_profile thermal:$live_state
EOF
}

write_input_module() {
  local target="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/omarchy-t2.lua"
  local temporary
  load_input_config
  local tts_read="omarchy-tts read" tts_pause="omarchy-tts toggle-pause"
  case $TTS_PROVIDER in
    qwen) ;;
    elevenlabs) tts_read="omarchy-elevenlabs-read"; tts_pause="omarchy-elevenlabs-read --pause" ;;
    *) die "unknown TTS provider: $TTS_PROVIDER" ;;
  esac
  temporary=$(mktemp)
  cat >"$temporary" <<EOF
-- Managed by omarchy-t2. Use omarchy-t2 input ... to change these values.
hl.config({
  input = {
    kb_layout = "$KEYBOARD_LAYOUT",
    kb_variant = "$KEYBOARD_VARIANT",
    touchpad = {
      tap_to_click = $TAP_TO_CLICK,
    },
  },
})

if $TTS_ENABLED then
  hl.unbind("ALT + R")
  hl.unbind("ALT + E")
  o.bind("ALT + R", "Read selected text from beginning", "$tts_read")
  o.bind("ALT + E", "Pause or resume selected text", "$tts_pause")
  if "$TTS_PROVIDER" == "elevenlabs" then
    hl.unbind("ALT + SHIFT + R")
    o.bind("ALT + SHIFT + R", "Read clipboard aloud", "omarchy-elevenlabs-read --clipboard")
  end
end

if $STT_ENABLED then
  hl.unbind("F9")
  o.bind("F9", "Start or stop dictation", "omarchy-elevenlabs-dictate toggle")
  hl.unbind("ALT + D")
  o.bind("ALT + D", "Start or stop dictation", "omarchy-elevenlabs-dictate toggle")
end
EOF
  if [[ ! -f $target ]] || ! grep -Fq -- '-- Managed by omarchy-t2.' "$target"; then
    backup_user_file "$target"
  fi
  install -Dm0644 "$temporary" "$target"
  rm -f "$temporary"
}

ensure_input_include() {
  local hyprland="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
  local temporary
  [[ -f $hyprland ]] || die "Omarchy Hyprland config is missing: $hyprland"
  grep -q '^-- omarchy-t2:start$' "$hyprland" && return 0

  backup_user_file "$hyprland"
  temporary=$(mktemp)
  cp "$hyprland" "$temporary"
  cat >>"$temporary" <<'EOF'

-- omarchy-t2:start
require("hypr.omarchy-t2")
-- omarchy-t2:end
EOF
  install -m0644 "$temporary" "$hyprland"
  rm -f "$temporary"
}

reload_hyprland() {
  if runtime && command -v hyprctl >/dev/null 2>&1 && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null
    local errors
    errors=$(hyprctl configerrors)
    [[ -z $errors ]] || die "Hyprland configuration errors: $errors"
  fi
}

input_apply() {
  write_input_module
  ensure_input_include
  reload_hyprland
}

input_keyboard() {
  local layout=$1
  local variant=${2:-}
  [[ $layout =~ ^[A-Za-z0-9,_+-]+$ ]] || die "invalid keyboard layout"
  [[ -z $variant || $variant =~ ^[A-Za-z0-9,_+-]+$ ]] || die "invalid keyboard variant"
  write_setting "$USER_CONFIG" KEYBOARD_LAYOUT "$layout" user
  write_setting "$USER_CONFIG" KEYBOARD_VARIANT "$variant" user
  input_apply
  note "Keyboard: $layout${variant:+ ($variant)}"
}

input_tap() {
  local value=$1
  case $value in
  on) write_setting "$USER_CONFIG" TAP_TO_CLICK true user ;;
  off) write_setting "$USER_CONFIG" TAP_TO_CLICK false user ;;
  *) die "tap must be on or off" ;;
  esac
  input_apply
  note "Tap-to-click: $value"
}

cloud_voice_require() {
  local kind=$1 command
  local commands=(python3 systemctl systemd-run notify-send)
  if [[ $kind == tts ]]; then commands+=(mpv wl-paste); else commands+=(pw-record ostt wtype flock); fi
  for command in "${commands[@]}"; do
    command -v "$command" >/dev/null || { echo "missing $command; see the ElevenLabs setup dependencies in README.md" >&2; return 1; }
  done
}

cloud_voice_stop() {
  runtime || return 0
  local unit=elevenlabs-read.service
  [[ $1 == stt ]] && unit=elevenlabs-dictate.service
  systemctl --user kill --kill-whom=all --signal=SIGCONT "$unit" 2>/dev/null || true
  systemctl --user stop "$unit" 2>/dev/null || true
}

cloud_voice_setup() {
  local kind=$1 assume_yes=${2:-false}
  cloud_voice_require "$kind"
  if [[ $kind == tts ]]; then
    note "Use ElevenLabs George / Flash v2.5. ALT+R reads, ALT+E pauses/resumes, ALT+SHIFT+R reads the clipboard."
    note "This replaces the read-aloud bindings, including Qwen when enabled."
  else
    note "Use ElevenLabs Scribe v2. Press F9 or ALT+D to start recording; press again to stop, transcribe and type into the focused app."
    note "This replaces any existing F9 and ALT+D bindings. Recording runs without a terminal popup."
  fi
  note "Selected text or recorded audio is sent to ElevenLabs using your account credits."
  confirm "Enable ElevenLabs $kind?" "$assume_yes" || return 0
  [[ $DRY_RUN == true ]] && { note "Dry run complete. No changes made."; return 0; }
  if [[ $kind == tts ]]; then
    cloud_voice_stop tts
    local qwen_launcher="$ROOT/usr/bin/omarchy-tts"
    [[ -x $qwen_launcher ]] && "$qwen_launcher" stop >/dev/null 2>&1 || true
    write_setting "$USER_CONFIG" TTS_PROVIDER elevenlabs user
    tts_set_enabled true
  else
    write_setting "$USER_CONFIG" STT_ENABLED true user
    input_apply
  fi
  note "Setup complete. Use 'omarchy-t2 $kind auth' to enter your key privately if not already configured."
}

cmd_stt() {
  require_supported_model
  local action=${1:-status} assume_yes=false
  shift || true
  case $action in
    auth) [[ $# == 0 ]] || die "usage: omarchy-t2 stt auth"; python3 "$LIB_DIR/elevenlabs_auth.py" ;;
    status)
      [[ $# == 0 ]] || die "usage: omarchy-t2 stt status"
      load_input_config
      printf 'provider=elevenlabs model=scribe_v2 configured.enabled=%s\n' "$STT_ENABLED"
      ;;
    setup|enable)
      while (($#)); do
        case $1 in
          --yes|-y) assume_yes=true ;;
          --dry-run) DRY_RUN=true ;;
          *) die "unknown STT setup option: $1" ;;
        esac
        shift
      done
      cloud_voice_setup stt "$assume_yes"
      ;;
    disable)
      [[ $# == 0 ]] || die "usage: omarchy-t2 stt disable"
      cloud_voice_stop stt
      write_setting "$USER_CONFIG" STT_ENABLED false user
      input_apply
      ;;
    *) die "usage: omarchy-t2 stt [status | setup [--yes] [--dry-run] | auth | enable | disable]" ;;
  esac
}

tts_models_ready() {
  [[ -f $TTS_MODEL_DIR/$TTS_TALKER && -f $TTS_MODEL_DIR/$TTS_CODEC ]]
}

tts_require_runtime() {
  local command
  [[ -x $TTS_ENGINE ]] || die "optional Qwen TTS engine is not installed: $TTS_ENGINE; install with WITH_QWEN_TTS=1 or set OMARCHY_T2_TTS_ENGINE to an existing Vulkan qwen-tts executable"
  for command in curl ffmpeg flock notify-send pw-play sha256sum wl-paste; do
    command -v "$command" >/dev/null 2>&1 || die "TTS dependency is missing: $command"
  done
}

tts_download_model() {
  local name=$1
  local url=$2
  local expected_sha256=$3
  local destination="$TTS_MODEL_DIR/$name"
  local partial="$destination.part"

  if [[ -f $destination ]] && printf '%s  %s\n' "$expected_sha256" "$destination" | sha256sum --check --status; then
    note "TTS model already verified: $name"
    return 0
  fi

  note "Downloading $name"
  curl --fail --location --retry 3 --continue-at - --output "$partial" "$url"
  if ! printf '%s  %s\n' "$expected_sha256" "$partial" | sha256sum --check --status; then
    rm -f "$partial"
    die "downloaded model failed checksum verification: $name"
  fi
  mv -f "$partial" "$destination"
}

tts_set_enabled() {
  local enabled=$1
  if [[ ! -r $USER_CONFIG ]]; then
    install -Dm0644 "$SHARE_DIR/defaults/input.conf" "$USER_CONFIG"
  fi
  write_setting "$USER_CONFIG" TTS_ENABLED "$enabled" user
  input_apply
}

tts_setup() {
  local assume_yes=false provider=qwen

  while (($#)); do
    case $1 in
    --yes|-y) assume_yes=true ;;
    --dry-run) DRY_RUN=true ;;
    --provider) [[ $# -ge 2 ]] || die "--provider requires qwen or elevenlabs"; provider=$2; shift ;;
    *) die "unknown TTS setup option: $1" ;;
    esac
    shift
  done

  case $provider in
    elevenlabs) cloud_voice_setup tts "$assume_yes"; return ;;
    qwen) ;;
    *) die "unknown TTS provider: $provider" ;;
  esac
  tts_require_runtime
  cat <<EOF
Omarchy T2 will download and verify about 1.4 GB of Qwen3-TTS Q4 models,
enable Vulkan synthesis with the Vivian voice, and bind:
  • ALT + R  read the primary selection
  • ALT + E  pause or resume speech

Models are stored under:
  $TTS_MODEL_DIR
EOF
  confirm "Set up GPU text-to-speech?" "$assume_yes" || exit 0
  if [[ $DRY_RUN == true ]]; then
    note "Dry run complete. No changes made."
    return 0
  fi

  install -d -m0755 "$TTS_MODEL_DIR"
  tts_download_model "$TTS_TALKER" "$TTS_TALKER_URL" "$TTS_TALKER_SHA256"
  tts_download_model "$TTS_CODEC" "$TTS_CODEC_URL" "$TTS_CODEC_SHA256"
  cloud_voice_stop tts
  write_setting "$USER_CONFIG" TTS_PROVIDER qwen user
  tts_set_enabled true
  note "GPU text-to-speech is ready. Select text and press ALT + R."
}

tts_enable() {
  load_input_config
  if [[ $TTS_PROVIDER == elevenlabs ]]; then
    cloud_voice_require tts
    tts_set_enabled true
    note "ElevenLabs text-to-speech enabled."
    return
  fi
  tts_require_runtime
  tts_models_ready || die "TTS models are missing; run 'omarchy-t2 tts setup'"
  tts_set_enabled true
  note "GPU text-to-speech enabled."
}

tts_disable() {
  cloud_voice_stop tts
  local launcher="$ROOT/usr/bin/omarchy-tts"
  [[ -x $launcher ]] && "$launcher" stop >/dev/null 2>&1 || true
  tts_set_enabled false
  note "Text-to-speech disabled."
}

tts_remove() {
  local assume_yes=${1:-false}
  confirm "Disable TTS and remove its downloaded models?" "$assume_yes" || exit 0
  tts_disable
  case $TTS_DATA_DIR in
  "$HOME"/*) rm -rf -- "$TTS_DATA_DIR" ;;
  *) die "refusing to remove TTS data outside the home directory: $TTS_DATA_DIR" ;;
  esac
  note "Removed downloaded TTS models."
}

touchbar_checkout_ready() {
  git -C "$TOUCHBAR_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
    [[ -x $TOUCHBAR_DIR/install.sh && -x $TOUCHBAR_DIR/uninstall.sh ]]
}

touchbar_fork_remote() {
  local remote url
  while IFS= read -r remote; do
    url=$(git -C "$TOUCHBAR_DIR" remote get-url "$remote" 2>/dev/null || true)
    case ${url%.git} in
    https://github.com/aminmarashi/react-drm-for-touchbar|git@*:aminmarashi/react-drm-for-touchbar|ssh://git@github.com/aminmarashi/react-drm-for-touchbar)
      echo "$remote"
      return 0
      ;;
    esac
  done < <(git -C "$TOUCHBAR_DIR" remote 2>/dev/null)
  return 1
}

touchbar_require_checkout() {
  touchbar_checkout_ready || die "react-drm checkout is missing or incomplete: $TOUCHBAR_DIR"
  touchbar_fork_remote >/dev/null || die "react-drm checkout is not connected to the AminMarashi fork: $TOUCHBAR_DIR"
}

touchbar_service_state() {
  if ! runtime; then
    echo unavailable
  elif systemctl --user is-active --quiet react-drm.service; then
    echo active
  elif systemctl --user is-enabled --quiet react-drm.service; then
    echo enabled
  else
    echo inactive
  fi
}

touchbar_source_state() {
  if ! touchbar_checkout_ready; then
    echo missing
  elif touchbar_fork_remote >/dev/null; then
    echo ready
  else
    echo wrong-remote
  fi
}

touchbar_status() {
  local revision=missing
  if touchbar_checkout_ready; then
    revision=$(git -C "$TOUCHBAR_DIR" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
  fi
  printf 'source=%s path=%s revision=%s service=%s\n' \
    "$(touchbar_source_state)" "$TOUCHBAR_DIR" "$revision" "$(touchbar_service_state)"
}

touchbar_clone() {
  if [[ -e $TOUCHBAR_DIR ]]; then
    touchbar_require_checkout
    return
  fi
  command -v git >/dev/null 2>&1 || die "git is required to clone react-drm"
  install -d -m0755 "$(dirname "$TOUCHBAR_DIR")"
  note "Cloning the AminMarashi react-drm fork into $TOUCHBAR_DIR"
  git clone --origin fork "$TOUCHBAR_REPO_URL" "$TOUCHBAR_DIR"
  touchbar_require_checkout
}

touchbar_analyze() {
  touchbar_require_checkout
  (cd "$TOUCHBAR_DIR" && ./install.sh analyze)
}

touchbar_setup() {
  touchbar_clone
  cat <<EOF
react-drm's installer will now analyze this machine before making changes.
It separately confirms removal of any conflicting Touch Bar daemon, installs
its Arch dependencies, preserves your editable config.ts, and deploys its
udev rule and user service from:
  $TOUCHBAR_DIR
EOF
  (cd "$TOUCHBAR_DIR" && ./install.sh)
}

touchbar_update() {
  local branch remote
  touchbar_require_checkout
  if ! git -C "$TOUCHBAR_DIR" diff --quiet || ! git -C "$TOUCHBAR_DIR" diff --cached --quiet; then
    die "react-drm has tracked local changes; commit or stash them before updating"
  fi
  branch=$(git -C "$TOUCHBAR_DIR" branch --show-current)
  [[ $branch == master ]] || die "switch the react-drm checkout to its master branch before updating"
  remote=$(touchbar_fork_remote)
  git -C "$TOUCHBAR_DIR" pull --ff-only "$remote" master
  touchbar_setup
}

touchbar_enable() {
  touchbar_require_checkout
  [[ -f $TOUCHBAR_DIR/linux-touchbar-control-center/dist/index.js ]] ||
    die "react-drm is not built; run 'omarchy-t2 touchbar setup'"
  [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/react-drm.service ]] ||
    die "react-drm user service is not installed; run 'omarchy-t2 touchbar setup'"
  user_systemctl daemon-reload
  user_systemctl enable --now react-drm.service
  note "react-drm Touch Bar enabled."
}

touchbar_disable() {
  user_systemctl disable --now react-drm.service
  note "react-drm Touch Bar disabled."
}

touchbar_uninstall() {
  touchbar_require_checkout
  (cd "$TOUCHBAR_DIR" && ./uninstall.sh)
}

# Compatibility: restore backups made by earlier profile-cleanup versions.
audio_restore_previous() {
  local kind=$1 scope manifest profile
  for scope in system user; do
    manifest="$USER_STATE/audio-$kind-$scope.removed"
    [[ -f $manifest ]] || continue
    while IFS= read -r profile; do
      [[ -n $profile ]] || continue
      if [[ $scope == system ]]; then
        restore_system_file "$profile"
      else
        restore_user_file "$profile"
      fi
    done <"$manifest"
    rm -f -- "$manifest"
  done
}

audio_restore_default_tuning() {
  local manifest="$USER_STATE/audio-default-tuning.removed"
  local state="$USER_STATE/audio-default-tuning.service-state"
  local profile enabled active
  [[ -f $state ]] || return 0
  if [[ -f $manifest ]]; then
    while IFS= read -r profile; do
      [[ -n $profile ]] && restore_user_file "$profile"
    done <"$manifest"
  fi
  user_systemctl daemon-reload
  read -r enabled active <"$state"
  if [[ $enabled == enabled ]]; then user_systemctl enable omarchy-speaker-tuning.service; fi
  if [[ $active == active ]]; then user_systemctl start omarchy-speaker-tuning.service; fi
  rm -f -- "$manifest" "$state"
}

audio_speakers_enable() {
  local local_bin="${XDG_BIN_HOME:-$HOME/.local/bin}"
  local target="$ROOT/etc/pipewire/pipewire.conf.d/10-omarchy-t2-speakers.conf"
  replace_system_link "$SHARE_DIR/audio/10-omarchy-t2-speakers.conf" "$target"
  replace_user_link "$LIB_DIR/audio-output-sink" "$local_bin/omarchy-audio-output-sink"
}

audio_speakers_disable() {
  restore_system_file "$ROOT/etc/pipewire/pipewire.conf.d/10-omarchy-t2-speakers.conf"
  audio_restore_previous speakers
  audio_restore_default_tuning
  # Also support backups created before migration manifests existed.
  local legacy="$ROOT/etc/pipewire/pipewire.conf.d/10-t2_161_speakers.conf"
  if [[ -e $(system_backup_path "$legacy") || -L $(system_backup_path "$legacy") ]]; then
    restore_system_file "$legacy"
  fi
  restore_user_file "${XDG_BIN_HOME:-$HOME/.local/bin}/omarchy-audio-output-sink"
}

audio_mic_enable() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  local old_service="$config_home/systemd/user/omarchy-mic-guard.service"
  replace_user_link "$SHARE_DIR/audio/10-omarchy-t2-mic.conf" "$config_home/pipewire/pipewire.conf.d/10-omarchy-t2-mic.conf"

  if [[ -e $old_service || -L $old_service ]]; then
    user_systemctl disable --now omarchy-mic-guard.service >/dev/null 2>&1 || true
    backup_user_file "$old_service"
    rm -f "$old_service"
  fi
  user_systemctl daemon-reload
  user_systemctl enable --now omarchy-t2-mic-guard.service
}

audio_mic_disable() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  user_systemctl disable --now omarchy-t2-mic-guard.service >/dev/null 2>&1 || true
  restore_user_file "$config_home/pipewire/pipewire.conf.d/10-omarchy-t2-mic.conf"
  audio_restore_previous mic
  restore_user_file "$config_home/systemd/user/omarchy-mic-guard.service"
  user_systemctl daemon-reload
}

restart_audio() {
  if runtime; then
    systemctl --user restart wireplumber pipewire pipewire-pulse
  fi
}

audio_mic_defaults() {
  runtime || return 0
  # v0.1.0 pinned the DSP mic and stored its volume at a near-silent level.
  # Reset both values when enabling DSP, then let WirePlumber route by priority.
  wpctl clear-default 1 2>/dev/null || true
  pactl set-source-volume effect_output.filter-chain-t2-mic 100% 2>/dev/null || true
}

audio_defaults() {
  runtime || return 0
  sleep 1
  pactl set-default-sink effect_input.filter-chain-speakers 2>/dev/null || true
  pactl set-sink-volume effect_input.filter-chain-speakers 100% 2>/dev/null || true
  pactl set-sink-volume alsa_output.pci-0000_04_00.3.HiFi__Speaker__sink 100% 2>/dev/null || true
  audio_mic_defaults
}

bluetooth_enable() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  local dropin="$config_home/systemd/user/bt-agent.service.d/omarchy-t2.conf"
  local legacy="$config_home/systemd/user/bt-agent.service.d/upstream-fix.conf"
  local agent="$LIB_DIR/bluetooth-agent"
  local temporary

  install -d -m0755 "$USER_STATE"
  touch "$USER_STATE/bluetooth-managed"
  replace_user_link "$SHARE_DIR/wireplumber/bluetooth-a2dp-autoconnect.conf" "$config_home/wireplumber/wireplumber.conf.d/omarchy-t2-a2dp-autoconnect.conf"
  if [[ -e $legacy || -L $legacy ]]; then
    backup_user_file "$legacy"
    rm -f "$legacy"
  fi
  if command -v omarchy-bluetooth-agent >/dev/null 2>&1; then
    agent=$(command -v omarchy-bluetooth-agent)
  fi
  temporary=$(mktemp)
  cat >"$temporary" <<EOF
# Managed by omarchy-t2.
[Service]
ExecStart=
ExecStart=$agent
EOF
  if [[ ! -f $dropin ]] || ! grep -Fq -- '# Managed by omarchy-t2.' "$dropin"; then
    backup_user_file "$dropin"
  fi
  install -Dm0644 "$temporary" "$dropin"
  rm -f "$temporary"
  user_systemctl daemon-reload
  user_systemctl enable --now bt-agent.service
  user_systemctl restart bt-agent.service
}

bluetooth_disable() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  local dropin="$config_home/systemd/user/bt-agent.service.d/omarchy-t2.conf"
  # Default setup must leave Bluetooth alone, including during restore.
  if [[ ! -e $USER_STATE/bluetooth-managed ]] && ! grep -Fq '# Managed by omarchy-t2.' "$dropin" 2>/dev/null; then
    return 0
  fi
  restore_user_file "$config_home/systemd/user/bt-agent.service.d/omarchy-t2.conf"
  restore_user_file "$config_home/systemd/user/bt-agent.service.d/upstream-fix.conf"
  restore_user_file "$config_home/wireplumber/wireplumber.conf.d/omarchy-t2-a2dp-autoconnect.conf"
  user_systemctl daemon-reload
  user_systemctl restart bt-agent.service
  rm -f "$USER_STATE/bluetooth-managed"
}

reset_to_package_defaults() {
  run_root install -Dm0644 "$SHARE_DIR/defaults/omarchy-t2.conf" "$SYSTEM_CONFIG"
  install -Dm0644 "$SHARE_DIR/defaults/input.conf" "$USER_CONFIG"
}

cmd_setup() {
  local assume_yes=false
  local defaults=false
  local with_bluetooth=false

  while (($#)); do
    case $1 in
    --yes|-y) assume_yes=true ;;
    --defaults) defaults=true ;;
    --bluetooth) with_bluetooth=true ;;
    --dry-run) DRY_RUN=true ;;
    *) die "unknown setup option: $1" ;;
    esac
    shift
  done

  require_supported_model
  cat <<EOF
Omarchy T2 will configure $SUPPORTED_MODEL with:
  • internal touchpad classification and palm rejection
  • 95% battery limit and linear cool fan profile
  • adaptive AC/battery, Radeon, Wi-Fi, USB, and thermal power policy
  • Mac ISO keyboard layout with tap-to-click disabled
  • protected six-speaker DSP and normalized microphone DSP
  • Bluetooth changes: $([[ $with_bluetooth == true ]] && echo enabled || echo skipped)

Existing files are backed up under:
  $SYSTEM_STATE
  $USER_STATE
EOF
  confirm "Apply the Omarchy T2 defaults?" "$assume_yes" || exit 0
  if [[ $DRY_RUN == true ]]; then
    note "Dry run complete. No changes made."
    return 0
  fi
  run_root true

  [[ $defaults == true ]] && reset_to_package_defaults
  load_system_config
  if [[ ! -r $USER_CONFIG ]]; then
    install -Dm0644 "$SHARE_DIR/defaults/input.conf" "$USER_CONFIG"
  fi

  setup_touchpad
  battery_limit "$BATTERY_LIMIT"
  fan_profile "$FAN_PROFILE"
  if [[ $POWER_ENABLED == true ]]; then
    power_enable
  else
    power_disable
  fi
  input_apply
  audio_speakers_enable
  audio_mic_enable
  if [[ $with_bluetooth == true ]]; then
    bluetooth_enable
  fi
  restart_audio
  audio_defaults

  note "Setup complete."
  if [[ $(touchbar_source_state) != ready ]]; then
    note "Optional: run 'omarchy-t2 touchbar setup' for the React DRM Touch Bar."
  fi
}

battery_actual_limit() {
  local path value
  path=$(find "$ROOT/sys/devices" -path '*/APP0001:00/battery_charge_limit' -print -quit 2>/dev/null || true)
  if [[ -r $path ]]; then
    value=$(<"$path")
    [[ $value =~ ^[0-9]+$ ]] && { echo "$value"; return; }
  fi
  echo unavailable
}

service_actual_state() {
  local state
  if runtime && state=$(systemctl show "$1" --property=ActiveState --value 2>/dev/null); then
    case $state in
      active|inactive|failed|activating|deactivating|reloading) echo "$state"; return ;;
    esac
  fi
  echo unavailable
}

fan_installed_profile() {
  local profile
  [[ -r $ROOT/etc/t2fand.conf ]] || { echo unavailable; return; }
  for profile in cool balanced quiet; do
    if cmp -s "$ROOT/etc/t2fand.conf" "$SHARE_DIR/fan/t2fand-$profile.conf"; then
      echo "$profile"
      return
    fi
  done
  echo custom
}

hypr_actual_option() {
  local json
  if runtime && json=$(hyprctl -j getoption "$1" 2>/dev/null); then
    if printf '%s' "$json" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    value = data["str"] if "str" in data else data["bool"]
    print(str(value).lower() if isinstance(value, bool) else value)
except (ValueError, KeyError, TypeError):
    sys.exit(1)
' 2>/dev/null; then return; fi
  fi
  echo unavailable
}

input_actual_state() {
  KEYBOARD_LAYOUT=$(hypr_actual_option input:kb_layout)
  KEYBOARD_VARIANT=$(hypr_actual_option input:kb_variant)
  TAP_TO_CLICK=$(hypr_actual_option input:touchpad:tap-to-click)
  [[ $KEYBOARD_VARIANT == unavailable ]] && KEYBOARD_VARIANT=
  return 0
}

tts_actual_state() {
  local bindings
  if runtime && bindings=$(hyprctl -j binds 2>/dev/null); then
    if printf '%s' "$bindings" | python3 -c '
import json, sys
try:
    bindings = json.load(sys.stdin)
    if not isinstance(bindings, list):
        sys.exit(1)
    print("enabled" if any(b.get("arg") in ("omarchy-tts read", "omarchy-elevenlabs-read") for b in bindings) else "disabled")
except (ValueError, AttributeError, TypeError):
    sys.exit(1)
' 2>/dev/null; then return; fi
  fi
  echo unavailable
}

audio_actual_state() {
  local nodes
  if runtime && nodes=$(pactl list short "$1" 2>/dev/null); then
    if awk -v node="$2" '$2 == node { found=1 } END { exit !found }' <<<"$nodes"; then
      echo active
    else
      echo inactive
    fi
  else
    echo unavailable
  fi
}

cmd_status() {
  local actual_battery tts_details
  load_input_config
  if [[ $TTS_PROVIDER == elevenlabs ]]; then
    tts_details="provider: elevenlabs; cloud"
  else
    tts_details="models: $(tts_models_ready && echo ready || echo missing); engine: $([[ -x $TTS_ENGINE ]] && echo ready || echo missing)"
  fi
  actual_battery=$(battery_actual_limit)
  [[ $actual_battery == unavailable ]] || actual_battery+='%'
  input_actual_state
  cat <<EOF
Model:          $(model_name)
Battery limit:  $actual_battery
Fan profile:    $(fan_installed_profile) (installed config; service: $(service_actual_state t2fanrd.service))
Power policy:   $(service_actual_state power-optimizer.service)
Keyboard:       $KEYBOARD_LAYOUT${KEYBOARD_VARIANT:+/$KEYBOARD_VARIANT}
Tap-to-click:   $TAP_TO_CLICK
Text-to-speech: $(tts_actual_state) (bindings; $tts_details)
Speech-to-text: configured.enabled=$STT_ENABLED (ElevenLabs Scribe v2)
Touch Bar UI:   $(touchbar_service_state) (source: $(touchbar_source_state))
Speaker DSP:    $(audio_actual_state sinks effect_input.filter-chain-speakers)
Microphone DSP: $(audio_actual_state sources effect_output.filter-chain-t2-mic)
EOF
}

doctor_check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then
    printf '[ok]   %s\n' "$label"
  else
    printf '[fail] %s\n' "$label"
    return 1
  fi
}

cmd_doctor() {
  local failures=0
  load_system_config
  load_input_config
  doctor_check "Supported model" test "$(model_name)" = "$SUPPORTED_MODEL" || failures=$((failures + 1))
  doctor_check "T2 kernel" grep -qi t2 /proc/sys/kernel/osrelease || failures=$((failures + 1))
  doctor_check "Touchpad rule" test -e "$ROOT/etc/udev/rules.d/99-omarchy-t2-touchpad.rules" || failures=$((failures + 1))
  doctor_check "Battery service" systemctl is-enabled omarchy-t2-battery-limit.service || failures=$((failures + 1))
  doctor_check "Fan service" systemctl is-active t2fanrd.service || failures=$((failures + 1))
  if [[ $POWER_ENABLED == true ]]; then
    doctor_check "Power optimizer" systemctl is-active power-optimizer.service || failures=$((failures + 1))
  fi
  doctor_check "Speaker DSP config" test -e "$ROOT/etc/pipewire/pipewire.conf.d/10-omarchy-t2-speakers.conf" || failures=$((failures + 1))
  doctor_check "Microphone DSP config" test -e "${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/10-omarchy-t2-mic.conf" || failures=$((failures + 1))
  doctor_check "Speaker DSP node" pactl get-sink-info effect_input.filter-chain-speakers || failures=$((failures + 1))
  doctor_check "Microphone DSP node" pactl get-source-info effect_output.filter-chain-t2-mic || failures=$((failures + 1))
  if [[ $TTS_ENABLED == true && $TTS_PROVIDER == qwen ]]; then
    doctor_check "TTS engine" test -x "$TTS_ENGINE" || failures=$((failures + 1))
    doctor_check "TTS models" tts_models_ready || failures=$((failures + 1))
    doctor_check "Radeon Vulkan driver" test -r "$ROOT/usr/share/vulkan/icd.d/radeon_icd.json" || failures=$((failures + 1))
  fi
  if [[ $TTS_ENABLED == true && $TTS_PROVIDER == elevenlabs ]]; then
    doctor_check "ElevenLabs TTS dependencies" cloud_voice_require tts || failures=$((failures + 1))
  fi
  if [[ $STT_ENABLED == true ]]; then
    doctor_check "Speech-to-text dependencies" cloud_voice_require stt || failures=$((failures + 1))
  fi
  ((failures == 0)) || return 1
}

remove_input_include() {
  local hyprland="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
  local temporary
  [[ -f $hyprland ]] || return 0
  temporary=$(mktemp)
  awk '
    $0 == "-- omarchy-t2:start" { skip = 1; next }
    $0 == "-- omarchy-t2:end" { skip = 0; next }
    !skip { print }
  ' "$hyprland" >"$temporary"
  install -m0644 "$temporary" "$hyprland"
  rm -f "$temporary"
}

cmd_restore() {
  local assume_yes=false
  local power_service_state=disabled
  local tts_launcher="$ROOT/usr/bin/omarchy-tts"
  [[ ${1:-} == --yes || ${1:-} == -y ]] && assume_yes=true
  require_supported_model
  confirm "Restore replaced files and remove downloaded TTS models?" "$assume_yes" || exit 0

  cloud_voice_stop tts
  cloud_voice_stop stt

  user_systemctl disable --now omarchy-t2-mic-guard.service >/dev/null 2>&1 || true
  [[ -x $tts_launcher ]] && "$tts_launcher" stop >/dev/null 2>&1 || true
  if runtime; then
    [[ -r $POWER_SERVICE_STATE ]] && power_service_state=$(< "$POWER_SERVICE_STATE")
    sudo systemctl disable --now omarchy-t2-battery-limit.service >/dev/null 2>&1 || true
    sudo systemctl disable --now power-optimizer.service >/dev/null 2>&1 || true
  fi

  audio_speakers_disable
  audio_mic_disable
  bluetooth_disable
  restore_system_file "$ROOT/etc/udev/rules.d/99-omarchy-t2-touchpad.rules"
  restore_system_file "$ROOT/etc/udev/rules.d/99-omarchy-apple-t2-touchpad.rules"
  restore_system_file "$ROOT/etc/udev/rules.d/90-omarchy-t2-battery.rules"
  restore_system_file "$ROOT/etc/t2fand.conf"
  restore_system_file "$ROOT/etc/systemd/system/power-optimizer.service"
  if runtime; then
    sudo systemctl daemon-reload
    if [[ $power_service_state == enabled ]]; then
      sudo systemctl enable --now power-optimizer.service
    fi
  fi
  restore_user_file "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/omarchy-t2.lua"
  if [[ -d $TTS_DATA_DIR ]]; then
    case $TTS_DATA_DIR in
    "$HOME"/*) rm -rf -- "$TTS_DATA_DIR" ;;
    *) die "refusing to remove TTS data outside the home directory: $TTS_DATA_DIR" ;;
    esac
  fi
  remove_input_include
  restart_audio
  reload_hyprland
  note "Restored previous configuration. The package can now be removed safely."
}

cmd_battery() {
  require_supported_model
  case ${1:-status} in
  status) battery_actual_limit ;;
  limit) [[ $# == 2 ]] || die "usage: omarchy-t2 battery limit <50-100>"; battery_limit "$2" ;;
  *) die "usage: omarchy-t2 battery [status | limit <50-100>]" ;;
  esac
}

cmd_fan() {
  require_supported_model
  case ${1:-status} in
  status)
    echo "profile=$(fan_installed_profile) (installed config)"
    if runtime; then "$LIB_DIR/fan-control" status; fi
    ;;
  profile) [[ $# == 2 ]] || die "usage: omarchy-t2 fan profile <cool|balanced|quiet>"; fan_profile "$2" ;;
  max|normal|toggle)
    [[ $# == 1 ]] || die "usage: omarchy-t2 fan ${1}"
    run_root "$LIB_DIR/fan-control" "$1"
    ;;
  *) die "usage: omarchy-t2 fan [status | profile <cool|balanced|quiet> | max | normal | toggle]" ;;
  esac
}

cmd_power() {
  require_supported_model
  case ${1:-status} in
  status) (($# <= 1)) || die "usage: omarchy-t2 power status"; power_status ;;
  enable) [[ $# == 1 ]] || die "usage: omarchy-t2 power enable"; power_enable ;;
  disable) [[ $# == 1 ]] || die "usage: omarchy-t2 power disable"; power_disable ;;
  profiles) [[ $# == 3 ]] || die "usage: omarchy-t2 power profiles <ac> <battery>"; power_profiles "$2" "$3" ;;
  thermal) shift; power_thermal "$@" ;;
  profile-switching) [[ $# == 2 ]] || die "usage: omarchy-t2 power profile-switching <on|off>"; power_boolean_setting POWER_PROFILE_SWITCHING "$2" ;;
  gpu-saving) [[ $# == 2 ]] || die "usage: omarchy-t2 power gpu-saving <on|off>"; power_boolean_setting POWER_GPU_SAVING "$2" ;;
  wifi-saving) [[ $# == 2 ]] || die "usage: omarchy-t2 power wifi-saving <on|off>"; power_boolean_setting POWER_WIFI_SAVING "$2" ;;
  usb-autosuspend) [[ $# == 2 ]] || die "usage: omarchy-t2 power usb-autosuspend <on|off>"; power_boolean_setting POWER_USB_AUTOSUSPEND "$2" ;;
  *) die "usage: omarchy-t2 power [status | enable | disable | profiles | thermal | profile-switching | gpu-saving | wifi-saving | usb-autosuspend]" ;;
  esac
}

cmd_input() {
  require_supported_model
  case ${1:-status} in
  status) input_actual_state; printf 'keyboard=%s/%s tap=%s\n' "$KEYBOARD_LAYOUT" "$KEYBOARD_VARIANT" "$TAP_TO_CLICK" ;;
  keyboard) (($# >= 2 && $# <= 3)) || die "usage: omarchy-t2 input keyboard <layout> [variant]"; input_keyboard "$2" "${3:-}" ;;
  tap) [[ $# == 2 ]] || die "usage: omarchy-t2 input tap <on|off>"; input_tap "$2" ;;
  *) die "usage: omarchy-t2 input [status | keyboard <layout> [variant] | tap <on|off>]" ;;
  esac
}

cmd_audio() {
  require_supported_model
  case ${1:-status} in
  status)
    cmd_status | grep -E '^(Speaker|Microphone) DSP:'
    ;;
  enable)
    audio_speakers_enable; audio_mic_enable; restart_audio; audio_defaults
    ;;
  disable)
    audio_speakers_disable; audio_mic_disable; restart_audio
    ;;
  speakers)
    [[ $# == 2 ]] || die "usage: omarchy-t2 audio speakers <on|off>"
    case $2 in
    on) audio_speakers_enable ;;
    off) audio_speakers_disable ;;
    *) die "speakers must be on or off" ;;
    esac
    restart_audio
    ;;
  mic)
    [[ $# == 2 ]] || die "usage: omarchy-t2 audio mic <on|off>"
    case $2 in
    on) audio_mic_enable ;;
    off) audio_mic_disable ;;
    *) die "mic must be on or off" ;;
    esac
    restart_audio
    if [[ $2 == on ]] && runtime; then
      sleep 1
      audio_mic_defaults
    fi
    ;;
  *) die "usage: omarchy-t2 audio [status | enable | disable | speakers <on|off> | mic <on|off>]" ;;
  esac
}

cmd_bluetooth() {
  require_supported_model
  case ${1:-status} in
  status)
    [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/bt-agent.service.d/omarchy-t2.conf ]] && echo enabled || echo disabled
    ;;
  enable) bluetooth_enable; restart_audio ;;
  disable) bluetooth_disable; restart_audio ;;
  *) die "usage: omarchy-t2 bluetooth [status | enable | disable]" ;;
  esac
}

cmd_gpu() {
  local current
  local requested=${1:-status}
  local gmux="$ROOT/etc/modprobe.d/apple-gmux.conf"

  require_supported_model
  if [[ -f $gmux ]] && grep -Eq '^[[:space:]]*options[[:space:]]+apple-gmux[[:space:]].*force_igd=(y|Y|1)([[:space:]]|$)' "$gmux"; then
    current=integrated
  else
    current=dedicated
  fi

  case $requested in
  status) echo "$current" ;;
  toggle) exec omarchy toggle hybrid gpu ;;
  integrated|dedicated)
    if [[ $requested == "$current" ]]; then
      note "GPU mode is already $current."
    else
      exec omarchy toggle hybrid gpu
    fi
    ;;
  *) die "usage: omarchy-t2 gpu [status | toggle | integrated | dedicated]" ;;
  esac
}

cmd_tts() {
  require_supported_model
  load_input_config
  case ${1:-status} in
  status)
    if [[ $TTS_PROVIDER == elevenlabs ]]; then
      printf 'provider=elevenlabs bindings=%s model=eleven_flash_v2_5 (default; optional voice config override)\n' "$(tts_actual_state)"
      return
    fi
    printf 'provider=%s bindings=%s models=%s engine=%s\n' \
      "$TTS_PROVIDER" \
      "$(tts_actual_state)" \
      "$(tts_models_ready && echo ready || echo missing)" \
      "$([[ -x $TTS_ENGINE ]] && echo ready || echo missing)"
    ;;
  auth) [[ $# == 1 ]] || die "usage: omarchy-t2 tts auth"; python3 "$LIB_DIR/elevenlabs_auth.py" ;;
  setup)
    shift
    tts_setup "$@"
    ;;
  enable) [[ $# == 1 ]] || die "usage: omarchy-t2 tts enable"; tts_enable ;;
  disable) [[ $# == 1 ]] || die "usage: omarchy-t2 tts disable"; tts_disable ;;
  remove)
    [[ $# == 1 || ($# == 2 && ($2 == --yes || $2 == -y)) ]] || die "usage: omarchy-t2 tts remove [--yes]"
    tts_remove "$([[ ${2:-} == --yes || ${2:-} == -y ]] && echo true || echo false)"
    ;;
  *) die "usage: omarchy-t2 tts [status | setup [--yes] [--dry-run] | enable | disable | remove [--yes]]" ;;
  esac
}

cmd_touchbar() {
  require_supported_model
  case ${1:-status} in
  status) [[ $# == 0 || $# == 1 ]] || die "usage: omarchy-t2 touchbar status"; touchbar_status ;;
  analyze) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar analyze"; touchbar_analyze ;;
  setup) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar setup"; touchbar_setup ;;
  update) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar update"; touchbar_update ;;
  enable) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar enable"; touchbar_enable ;;
  disable) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar disable"; touchbar_disable ;;
  uninstall) [[ $# == 1 ]] || die "usage: omarchy-t2 touchbar uninstall"; touchbar_uninstall ;;
  *) die "usage: omarchy-t2 touchbar [status | analyze | setup | update | enable | disable | uninstall]" ;;
  esac
}

command=${1:-help}
shift || true
if [[ $EUID == 0 && -z $ROOT ]]; then
  case $command in
  help|--help|-h|version|--version|-v) ;;
  *) die "run this command as your normal Omarchy user; it requests sudo when needed" ;;
  esac
fi
case $command in
setup) cmd_setup "$@" ;;
status) cmd_status ;;
doctor) cmd_doctor ;;
battery) cmd_battery "$@" ;;
fan) cmd_fan "$@" ;;
power) cmd_power "$@" ;;
input) cmd_input "$@" ;;
audio) cmd_audio "$@" ;;
bluetooth) cmd_bluetooth "$@" ;;
gpu) cmd_gpu "$@" ;;
touchbar) cmd_touchbar "$@" ;;
tts) cmd_tts "$@" ;;
stt) cmd_stt "$@" ;;
restore) cmd_restore "$@" ;;
version|--version|-v) echo "omarchy-t2 $VERSION" ;;
help|--help|-h) usage ;;
*) usage >&2; exit 1 ;;
esac
